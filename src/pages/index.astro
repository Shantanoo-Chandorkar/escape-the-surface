---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import InstallButton from '../components/layout/InstallButton.jsx';
import { getCategorySummaries } from '../utils/getCategorySummaries';
import { formatTitle } from '../utils/formatTitle';
import categoryMeta from '../data/categoryMeta';
import '../styles/editorial.css';

const categories = await getCategorySummaries();

const FEATURED_SLUGS = [
    'closures',
    'event-loop',
    'what-is-fiber',
    'usestate-internals',
    'ssr-and-ssg-when-html-is-generated',
    'server-and-client-components-and-data-fetching',
];
const allTopics = await getCollection('topics');
const featured = FEATURED_SLUGS.map((slug) => allTopics.find((topic) => topic.id === slug)).filter(Boolean);

const javascriptTopics = allTopics
    .filter((topic) => topic.data.category === 'javascript')
    .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));
const firstLesson = javascriptTopics[0];
---

<MainLayout
    title="EscapeTheSurface | Master React Internals"
    description="Interview prep, React internals, and Next.js rendering, explained by what's actually happening underneath."
>
    <div class="editorial-page">
        <div class="editorial-hero">
            <h1>Escape the surface of web development.</h1>
            <p>
                Interview prep, React internals, and Next.js rendering, explained by what's
                actually happening underneath, not by what the docs assume you already know.
            </p>
            <strong>More topics coming soon</strong>
        </div>

        <div class="editorial-section">
            <h2>Pick where you're stuck</h2>
            <div class="editorial-category-grid">
                {categories.map((category) => (
                    <a class="editorial-category-link-block" href={`/categories/${category.slug}`}>
                        <div class="editorial-category-block">
                            <h3 class="editorial-category-name">{category.name}</h3>
                            {category.description && <p class="editorial-category-desc">{category.description}</p>}
                            <span class="editorial-category-count">
                                {category.count} lesson{category.count === 1 ? '' : 's'}
                            </span>
                        </div>
                    </a>
                ))}
            </div>
            <a class="editorial-browse-link" href="/categories">Browse all categories</a>
        </div>

        <div class="editorial-section">
            <h2>A closer look</h2>
            <ul class="editorial-topic-list">
                {featured.map((topic) => (
                    <li class="editorial-topic-row">
                        <a href={`/topic/${topic.id}`}>{topic.data.title}</a>
                        <span class="editorial-topic-tag">
                            {categoryMeta[topic.data.category]?.name ?? formatTitle(topic.data.category)}
                        </span>
                    </li>
                ))}
            </ul>
        </div>

        {firstLesson && (
            <div class="editorial-section editorial-cta-section">
                <h2>Start where interviews start</h2>
                <p>
                    The first lesson covers var, let, and const, the stuff everyone assumes is too
                    basic to ask about.
                </p>
                <a class="editorial-cta-button" href={`/topic/${firstLesson.id}`}>
                    Start with {firstLesson.data.title}
                </a>
            </div>
        )}

        <div class="editorial-section editorial-cta-section">
            <h2>Install our PWA</h2>
            <p>
                Installed, it opens in its own window and the lessons you have already read stay
                readable with no connection.
            </p>
            <div class="editorial-cta-actions">
                <InstallButton client:load label="Install" className="editorial-cta-button" />
                <a class="editorial-cta-button-secondary" href="/topic/what-is-a-pwa">
                    What's a PWA?
                </a>
            </div>
        </div>
    </div>
</MainLayout>
