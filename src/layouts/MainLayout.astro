---
/**
 * MainLayout.astro
 *
 * The root HTML shell for every page. Imports all global CSS, mounts
 * the Header and Sidebar as React islands (client:load so they hydrate
 * immediately and share the Zustand store), and provides a <slot /> for
 * page-specific content.
 *
 * OG / social meta tags are optional props - the topic page passes them
 * at build time so every crawlable URL gets proper previews without an
 * edge function.
 */
import Header from '../components/layout/Header.jsx';
import Sidebar from '../components/layout/Sidebar.jsx';
import ProgressBar from '../components/ProgressBar.jsx';
import NavigationProgressBar from '../components/NavigationProgressBar.jsx';
import '../index.css';
import '../App.css';
import '../components/layout/Layout.css';

interface Props {
    title?: string;
    description?: string;
    ogTitle?: string;
    ogImage?: string;
    ogUrl?: string;
    currentPath?: string;
}

const {
    title = 'EscapeTheSurface',
    description = 'Master the internal mechanisms of the Frontend. A deep-dive platform for engineering high-caliber React developers.',
    ogTitle,
    ogImage,
    ogUrl,
    currentPath = Astro.url.pathname,
} = Astro.props;

const GA_MEASUREMENT_ID = import.meta.env.VITE_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#a65d57" />
        <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />

        {GA_MEASUREMENT_ID && (
            <>
                <!-- Google tag (gtag.js) -->
                <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
                ></script>
                <script define:vars={{ GA_MEASUREMENT_ID }}>
                    window.dataLayer = window.dataLayer || [];
                    function gtag() {
                        dataLayer.push(arguments);
                    }
                    gtag('js', new Date());
                    gtag('config', GA_MEASUREMENT_ID);
                </script>
            </>
        )}

        {ogTitle && <meta property="og:type" content="article" />}
        {ogTitle && <meta property="og:title" content={ogTitle} />}
        {ogTitle && <meta property="og:description" content={description} />}
        {ogUrl && <meta property="og:url" content={ogUrl} />}
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta property="og:image:width" content="1200" />}
        {ogImage && <meta property="og:image:height" content="630" />}
        {ogImage && <meta name="twitter:card" content="summary_large_image" />}
        {ogImage && <meta name="twitter:image" content={ogImage} />}
    </head>
    <body>
        <div class="layout-root">
            <ProgressBar mode="scroll" scrollTarget=".layout-content" color="var(--primary-color)" client:load />
            <NavigationProgressBar client:load />
            <Header client:load />
            <div class="layout-body">
                <Sidebar currentPath={currentPath} client:visible />
                <main class="layout-content">
                    <slot />
                </main>
            </div>
        </div>
    </body>
</html>
